                                    -- ball is dangerous well outside any\
                                    -- straight-line net - its future path is\
                                    -- not knowable - so within 3x Sweep\
                                    -- Range it trips on the flag alone.\
                                    if curve and dist <= desyncConfig.range * 3 then trip = true end\
                                    -- CLASS SWEEP trigger D: the game's own\
                                    -- target stamp (same signal the auto\
                                    -- parry uses) - ANY distance, ANY class.\
                                    local okTarget, ballTarget = pcall(ball.GetAttribute, ball, \"target\")\
                                    if okTarget and ballTarget == myName then trip = true end\
                                    -- RATCHET write: extend only, never\
