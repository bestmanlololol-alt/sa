pcall(function()\
    local net = ReplicatedStorage.Packages._Index[\"sleitnick_net@0.1.0\"].net\
    local pullRemote = net:FindFirstChild(\"RE/PlrPulled\") or net:FindFirstChild(\"RE/PlrPulsed\")\
    if pullRemote then\
