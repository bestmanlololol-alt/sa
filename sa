                                    -- this class's net.\
                                    if dist <= clsRange then trip = true end\
                                    -- CLASS SWEEP trigger B: in-flight inside\
                                    -- this class's lead window (wide 0.2\
                                    -- cone, NO distance cap - the ETA window\
                                    -- itself scales the reach with ball\
                                    -- speed, so every class is seen its lead\
                                    -- seconds before arrival).\
                                    if sp > 1 and inbound > 0.2 and dist / sp <= clsLead then trip = true end\
