local function _macroTick(dt)
    if not captured.remote then return end
    dt = dt or 0.016
    if Macro.macro1Active then
        Macro._m1acc = Macro._m1acc + dt
        local interval = 1 / math.min(math.max(Macro.m1Cps, 1), 200)
        if Macro._m1acc >= interval then Macro._m1acc = 0; BallHelper.parry() end
    end
    if Macro.macro2Active then
        Macro._m2acc = Macro._m2acc + dt
        local interval = 1 / math.min(math.max(Macro.m2Cps, 1), 200)
        if Macro._m2acc >= interval then Macro._m2acc = 0; BallHelper.parry() end
    end
    if Macro.enabled then
        Macro._acc = Macro._acc + dt
        local interval = 1 / math.min(math.max(Macro.cps, 1), 200)
        if Macro._acc >= interval then Macro._acc = 0; BallHelper.parry() end
    end
end
local function _startMacroLoop()
    if Macro._conn then return end
    Macro._conn = RunService.Heartbeat:Connect(_macroTick)
end
local function _stopMacroLoop()
    if Macro._conn then Macro._conn:Disconnect() Macro._conn = nil end
    Macro._acc = 0; Macro._m1acc = 0; Macro._m2acc = 0
end

-- ====================== ESP ==============================================
local espBillboards, espConns = {}, {}
local function create_esp(player)
    task.spawn(function()
        local character = player.Character
        while not character or not character.Parent do task.wait(); character = player.Character end
        local head = character:WaitForChild("Head", 10)
        if not head or not getgenv().AbilityESP then return end
        local existing = head:FindFirstChild("AbilityESPGui"); if existing then existing:Destroy() end
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "AbilityESPGui"; billboard.Adornee = head
        billboard.Size = UDim2.new(0, 220, 0, 60); billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true; billboard.Parent = head
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0); label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255); label.TextSize = 14
        label.TextStrokeTransparency = 0; label.Font = Enum.Font.Roboto; label.RichText = true
        label.TextXAlignment = Enum.TextXAlignment.Center; label.TextYAlignment = Enum.TextYAlignment.Center
        label.Parent = billboard; label.Visible = false
        espBillboards[player] = label
        local hb
        hb = RunService.Heartbeat:Connect(function()
            if not (character and character.Parent) then
                if hb then hb:Disconnect() end
                pcall(function() billboard:Destroy() end)
                espBillboards[player] = nil; return
            end
            if getgenv().AbilityESP then
                label.Visible = true
                local ability = player:GetAttribute("EquippedAbility")
                if ability then label.Text = "<b>"..player.DisplayName.." ["..ability.."]</b>"
                else label.Text = "<b>"..player.DisplayName.."</b>" end
            else label.Visible = false end
        end)
        espConns[player] = hb
    end)
end
local function start_esp()
    getgenv().AbilityESP = true
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            p.CharacterAdded:Connect(function() create_esp(p) end)
            if p.Character then task.spawn(function() create_esp(p) end) end
        end
    end
    Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function() if getgenv().AbilityESP then create_esp(p) end end)
    end)
end
local function stop_esp()
    getgenv().AbilityESP = false
    for _, c in pairs(espConns) do pcall(function() c:Disconnect() end) end
    espConns = {}
    for _, l in pairs(espBillboards) do pcall(function() if l and l.Parent then l.Parent:Destroy() end end) end
    espBillboards = {}
end

