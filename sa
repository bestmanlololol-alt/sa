local FFLAG_FILE = "Seraphim/fflags.json"
pcall(function() if makefolder and not isfolder("Seraphim") then makefolder("Seraphim") end end)
local function loadFFlagsMap()
    local map = getgenv()._SeraphimFFlags or {}
    pcall(function()
        if isfile and isfile(FFLAG_FILE) then
            local d = HttpService:JSONDecode(readfile(FFLAG_FILE))
            if type(d) == "table" then map = d end
        end
    end)
    getgenv()._SeraphimFFlags = map; return map
end
local function saveFFlags(map) pcall(function() if writefile then writefile(FFLAG_FILE, HttpService:JSONEncode(map)) end end) end
local function applyFFlag(name, value)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return false, "empty name" end
    local ok, err = pcall(function()
        if setfflag then setfflag(name, tostring(value))
        elseif setfflags then setfflags(name, tostring(value))
        else error("no setfflag") end
    end)
    if ok then
        local map = loadFFlagsMap(); map[name] = tostring(value)
        saveFFlags(map); getgenv()._SeraphimFFlags = map
    end
    return ok, err
end
task.spawn(function() for k, v in pairs(loadFFlagsMap()) do pcall(applyFFlag, k, v) end end)

