            -- v210 ONE IMMORTAL: enabling EclipseImmortal from the floating\
            -- button auto-stops the Semi Immortal engine (this file-level\
            -- block cannot see the Immortal tab's locals, so the stop rides\
            -- the getgenv bridges the tab publishes).\
            if getgenv()._ENX_SemiDesyncIsActive and getgenv()._ENX_SemiDesyncIsActive() then\
                if getgenv()._ENX_SemiDesyncStop then getgenv()._ENX_SemiDesyncStop() end\
                ENXNotify.new('EclipseNexus', 'EclipseNexus Semi Immortal auto-stopped - run ONE immortal system', 3)\
            end\
            if getgenv()._ENX_EnsureImmortalityHook then pcall(getgenv()._ENX_EnsureImmortalityHook) end\
        end\
        if UI.ImmortalityToggle then\
            UI.ImmortalityToggle:SetValue(Immortality.Enabled)\
        end\
        ImmortalityUIService:SetColor(Immortality.Enabled)\
        SaveAllSettings()\
    end\
