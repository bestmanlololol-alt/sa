            local ballPos = ball.Position\
            local diff = playerPos - ballPos\
        local distSq = diff.X*diff.X + diff.Y*diff.Y + diff.Z*diff.Z\
        if distSq < 1 then continue end\
        local dist = math.sqrt(distSq)\
