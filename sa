        -- UI, and one error here must not kill the respawn re-apply\
        -- chain (the v183 calls ran bare - a single failure silently\
        -- disabled every future re-apply).\
        isDragging = false\
        dragStart = nil\
        startPos = nil\
        pcall(updateOverhead)\
        watchCharacter(char)\
    end)\
