        if shouldFire then\
            -- MARK GLOBAL LOCK — prevents Bloodmoon's loop from double-firing\
            MarkFired()\
            ballState.Parried = true\
            ballState.LastParry = now\
            ENXData.Global.AutoParryParried = true\
