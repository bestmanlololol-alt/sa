-- Set up _ZX_PingCache (Core uses this everywhere)\
-- v132 PING OPTIMIZATION (upgrades v130's plain EMA):\
--   * sample every 0.25s (was 0.5s) - 2x resolution\
--   * spike rejection: running median of the last 8 raw samples; a sample\
--     above median * 2.5 + 30 ms is a lag/GC spike and feeds the EMA at\
--     only 15% of its excess instead of full weight\
--   * EMA alpha 0.4 per 0.25s sample => ~0.49s time constant (was ~1.4s)\
-- Net: the smoothed ping follows real ping changes ~2.9x faster, a single\
-- 800ms spike on a 40ms base moves the estimate to ~86 instead of ~268\
-- (80% less spike transfer) and it recovers in ~0.5s instead of ~1.4s.\
-- Readers: curve math (v130), spam range (v132). Raw cache untouched for\
-- parry_accuracy and every other reader.\
local _zxPingSamples = {}\
task.spawn(function()\
    while true do\
        pcall(function()\
            local raw = Stats.Network.ServerStatsItem[\"Data Ping\"]:GetValue()\
            getgenv()._ZX_PingCache = raw\
            if type(raw) == \"number\" and raw > 0 then\
                table.insert(_zxPingSamples, raw)\
                if #_zxPingSamples > 8 then table.remove(_zxPingSamples, 1) end\
                local sorted = table.clone(_zxPingSamples)\
                table.sort(sorted)\
                local median = sorted[math.ceil(#sorted / 2)]\
                local fed = raw\
                if raw > median * 2.5 + 30 then\
                    fed = median + (raw - median) * 0.15\
                end\
                local smooth = getgenv()._ZX_PingSmooth\
                getgenv()._ZX_PingSmooth = (smooth and (smooth * 0.6 + fed * 0.4)) or fed\
            end\
        end)\
        task.wait(0.25)\
    end\
end)\
