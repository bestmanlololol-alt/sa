                                    --     Boost seconds - curve balls are\
                                    --     the ones that beat a\
                                    --     straight-line parry.\
                                    -- (4) MISS FLAG - a ball inside its\
                                    --     class net that is STILL flying\
                                    --     at you (inbound > 0; a deflected\
                                    --     ball flies away) is a missed\
                                    --     parry: Miss Boost seconds are\
                                    --     added on top.\
                                    -- (5) RATCHET - every deadline write\
                                    --     is math.max: holds can only\
                                    --     extend, never shorten; a second\
                                    --     ball can never weaken the hold\
                                    --     the first one built.\
                                    local okVel, vel = pcall(function() return part.AssemblyLinearVelocity end)\
                                    local sp = okVel and vel.Magnitude or 0\
                                    -- velocity unreadable = fail open for\
                                    -- this ball if it is anywhere near you\
                                    if not okVel and dist <= desyncConfig.range * 2 then\
                                        desyncSmartNearUntil = math.max(desyncSmartNearUntil, now + desyncConfig.holdMed)\
                                        return\
                                    end\
                                    -- (1) CLASSIFY from the real speed\
                                    local cls = \"MEDIUM\"\
                                    if sp < desyncConfig.slowCap then\
                                        cls = \"SLOW\"\
                                    elseif sp > desyncConfig.fastFloor then\
                                        cls = \"FAST\"\
                                    end\
                                    local prof = DESYNC_CLASS_PROFILE[cls]\
                                    local inbound = 0\
                                    if sp > 1 then inbound = vel.Unit:Dot(-offset.Unit) end\
                                    -- (3) CURVE FLAG from the real turn rate\
                                    -- of the flight path (direction memory,\
