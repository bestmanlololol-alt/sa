            ENXData.Config.AutoSpamParry.ParryThreshold = _pth\
            getgenv().AutoSpamThreshold = _pth\
        end\
        -- v130: DistanceMultiplier load push removed with its slider (config\
        -- KEY kept for save-file compatibility, same policy as CPS/SpamBoost).\
        getgenv().SpamBoost = (ENXData.Config.AutoSpamParry.SpamBoost == true)\
        getgenv().ParryBoost = (ENXData.Config.AutoParry.ParryBoost == true)\
        local _Sys = getgenv()._ENX_System\
        if _Sys and _Sys.__properties then\
            if _pth then _Sys.__properties.__spam_threshold = _pth end\
            -- v209: SLIDER LOAD PUSH (the UI lib does not fire slider/toggle\
            -- callbacks on registration - until the user re-dragged a slider\
            -- the engine kept DEFAULTS while the UI showed the saved value;\
            -- only ParryThreshold was pushed above). Push every saved combat\
            -- value into the live engine exactly like its callback does.\
            -- Lobby first, main second - the main Accuracy slider wins on\
            -- load (both feed the one field the window reads, v171).\
            local _lacc = tonumber(ENXData.Config.ParrySettings.LobbyAutoParryAccuracy)\
            if _lacc and getgenv().ParryBoost ~= true then\
                _Sys.__properties.__accuracy = math.clamp(_lacc, 1, 100)\
            end\
            local _acc = tonumber(ENXData.Config.ParrySettings.AutoParryAccuracy)\
            if _acc then\
