local function stopManualSpamLoop()
    if ManualSpam.conn then
        ManualSpam.conn:Disconnect()
        ManualSpam.conn = nil
    end
    ManualSpam.accumulator = 0
end

local function startManualSpamLoop()
    stopManualSpamLoop()
    ManualSpam.conn = RunService.Heartbeat:Connect(function(dt)
        if not ManualSpam.active then
            stopManualSpamLoop()
            return
        end
        if not captured.remote then return end
        if not LocalPlayer.Character or LocalPlayer.Character.Parent ~= workspace.Alive then return end

        ManualSpam.accumulator = ManualSpam.accumulator + (dt or 0)
        local interval
        if Config.ManualCPSEnabled then
            interval = 1 / math.clamp(Config.ManualCPS or 100, 1, 2000)
        else
            interval = 1 / math.max(1, Config.SpamCPS or 100)
        end
        if ManualSpam.accumulator < interval then return end
        ManualSpam.accumulator = 0
        BallHelper.parry()
    end)
end

