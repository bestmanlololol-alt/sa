    -- ===== SINGLE GLOBAL PARRY COUNTER (prevents double-firing) =====\
    -- Both this boost loop and Bloodmoon's MainConnection check this.\
    -- Once set, NO parry can fire for 0.4 seconds.\
    if not getgenv()._ENX_ParryLock then\
        getgenv()._ENX_ParryLock = { lastFire = 0, LOCK_TIME = 0.4 }\
    end\
    local ParryLock = getgenv()._ENX_ParryLock\
\
    -- Helper: can we fire?\
    local function CanFire()\
        return (tick() - ParryLock.lastFire) >= ParryLock.LOCK_TIME\
    end\
\
    -- Helper: mark that we fired (locks both loops)\
    local function MarkFired()\
        ParryLock.lastFire = tick()\
    end\
\
    -- Hook into Bloodmoon's FireParry so it also respects the lock\
    -- This prevents Bloodmoon's MainConnection from double-firing after our boost\
    -- ALSO: during spam boost, completely block Bloodmoon's FireParry to prevent\
    -- double-clicking (the boost handles all spam fires via _PARRY_PATCH.fire directly)\
    getgenv()._ENX_SpamBoostActive = false  -- set true when boost is handling spam\
    local OriginalFireParry = FireParry\
    FireParry = function(...)\
        -- During spam boost, block Bloodmoon's native FireParry completely\
        if getgenv()._ENX_SpamBoostActive then return end\
        -- v108: NEVER lock during spam modes — the 0.4s global lock was\
        -- throttling manual spam / auto spam to 2.5 fires/sec, which is\
        -- way too slow for clash mode. Spam loops now use fireSpam()\
        -- directly (bypassing FireParry entirely), so this hook only\
        -- affects auto-parry / parry-boost — which is correct.\
        local isSpamming = ENXData.Config.AutoSpamParry.Spamming\
            or ENXData.Config.ManualSpamParry.Spamming\
        if not isSpamming and not CanFire() then return end\
        if not isSpamming then\
            MarkFired()\
            -- Also mark Bloodmoon's ball state as parried to stop its loop\
            for _, ball in ipairs(ENXData.Balls:GetChildren()) do\
                local st = ENXData.Parry[ball]\
                if st and not st.Parried then\
                    st.Parried = true\
                    st.LastParry = tick()\
                end\
            end\
            ENXData.Global.AutoParryParried = true\
        end\
        return OriginalFireParry(...)\
