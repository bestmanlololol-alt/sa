            -- second forever - a guaranteed stutter every second even when idling.\
            -- Now: 1s polling only until every remote was processed once, then\
            -- a light 15s re-check for late connections (fxHookedFuncs still\
            -- prevents any double hooking).\
            local fxSeenRemotes, fxAllDone = {}, false\
            while task.wait(fxAllDone and 15 or 1) do\
