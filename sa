    local ParryBoost = {\
        Enabled = false,\
        PreClick = 1.3,       -- fire at 1.3x normal parry range\
        HitSound = false,     -- play sound on parry\
        Mode = \"Distance\",    -- \"Distance\" (Invisible) or \"Time\" (Invisible)\
        Timing = 100,         -- Distance timing scale (0-100%)\
        TargetTime = 0.3,     -- Time mode: target window seconds\
